   "source": [
    "### Explore Pertanyaan Bisnis 2: \n",
    "\n",
    "***\"Negara bagian (state) mana yang menghasilkan revenue tertinggi, dan bagaimana rata-rata waktu pengiriman pada masing-masing state selama tahun 2018?\"***"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 53,
   "id": "33ea5870",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Filter orders: Hanya tahun 2018 dan status 'delivered'\n",
    "orders_2018 = orders[(orders['order_purchase_timestamp'].dt.year == 2018) & \n",
    "                     (orders['order_status'] == 'delivered')].copy()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 54,
   "id": "3cd57593",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Menghitung waktu pengiriman barang (Delivery Time dalam format hari)\n",
    "orders_2018['delivery_time_days'] = (orders_2018['order_delivered_customer_date'] - orders_2018['order_purchase_timestamp']).dt.days"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 55,
   "id": "7a00da0d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Menggabungkan data dengan informasi state customer dan total pembayaran per order\n",
    "state_df = orders_2018.merge(customers[['customer_id', 'customer_state']], on='customer_id', how='inner')\n",
    "state_df = state_df.merge(order_payments_agg, on='order_id', how='inner')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 56,
   "id": "11e8b6df",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Agregasi untuk mencari Total Revenue dan Rata-rata Delivery Time per Negara Bagian (State)\n",
    "state_summary = state_df.groupby('customer_state').agg({\n",
    "    'payment_value': 'sum',\n",
    "    'delivery_time_days': 'mean'\n",
    "}).reset_index()\n",
    "\n",
    "state_summary.rename(columns={\n",
    "    'payment_value': 'Total_Revenue',\n",
    "    'delivery_time_days': 'Avg_Delivery_Time_Days'\n",
    "}, inplace=True)\n"
   ]
  },
