    "# Analisis lanjutan membandingkan overlap antara Top 10 Revenue dan Top 10 Delivery Time Tercepat\n",
    "\n",
    "top10_rev_states = set(top10_revenue['customer_state'])\n",
    "top10_fast_states = set(top10_delivery['customer_state'])\n",
    "\n",
    "overlap_states = top10_rev_states & top10_fast_states\n",
    "only_revenue = top10_rev_states - top10_fast_states\n",
    "only_fast = top10_fast_states - top10_rev_states\n",
    "\n",
    "print(\"State yang masuk Top 10 Revenue DAN Top 10 Delivery Tercepat:\", sorted(overlap_states))\n",
    "print(\"State yang HANYA masuk Top 10 Revenue :\", sorted(only_revenue))\n",
    "print(\"State yang HANYA masuk Top 10 Delivery Tercepat :\", sorted(only_fast))\n",
    "\n",
    "# Melihat posisi rank tiap state pada kedua metrik untuk state yang overlap\n",
    "state_summary_full = state_summary.copy()\n",
    "state_summary_full['Revenue_Rank'] = state_summary_full['Total_Revenue'].rank(ascending=False)\n",
    "state_summary_full['Delivery_Rank'] = state_summary_full['Avg_Delivery_Time_Days'].rank(ascending=True)\n",
    "\n",
    "display(\n",
    "    state_summary_full[state_summary_full['customer_state'].isin(overlap_states)]\n",
    "    .sort_values(by='Revenue_Rank')[['customer_state', 'Total_Revenue', 'Avg_Delivery_Time_Days', 'Revenue_Rank', 'Delivery_Rank']]\n",
    ")"
   ]
